# Local development. Copy to .env; never commit real credentials.
API_HOST=127.0.0.1
API_PORT=4000
MEMVORA_API_URL=http://127.0.0.1:4000
# Local SQLite data defaults to this project's ignored .memvora folder.
# MEMVORA_DATA_DIR=C:/absolute/path/to/local-data
# API bootstrap creates a local token. Do not paste it into the website.
# MEMVORA_LOCAL_TOKEN=
# Optional personal-local GitHub App. See docs/GITHUB_SETUP.md for registration.
# Enable App ID, client ID and client secret together; the callback must match registration.
# ANY nonempty App setting below requests App mode and disables the gh CLI fallback.
# Leave all four unset to use your existing gh auth login identity.
# GITHUB_APP_ID=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://127.0.0.1:3000/api/github/oauth/callback
# Restart the API and website after changes. Never use NEXT_PUBLIC_* for credentials.
# Hosted database and webhook/private-key integrations remain future configuration.
# DATABASE_URL=postgresql://memvora:change-me@127.0.0.1:5432/memvora
# GITHUB_WEBHOOK_SECRET=
# GITHUB_PRIVATE_KEY_PATH=
# Optional HTTP AI enrichment; disabled until explicitly enabled with a provider.
MEMVORA_AI_ENABLED=false
# AI_BASE_URL=https://your-provider.example/v1
# AI_API_KEY=
# AI_MODEL=
# AI_EMBEDDING_MODEL=
