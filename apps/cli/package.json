{
  "name": "@memvora/cli",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "bin": {
    "memvora": "./dist/index.js"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=../../.env dist/index.js"
  },
  "dependencies": {
    "@memvora/core": "*",
    "@memvora/contracts": "*",
    "commander": "15.0.0",
    "typebox": "1.4.2"
  }
}
